{
  "name": "Prezzy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "biome check .",
    "test": "turbo test test:browser",
    "dev:web": "turbo -F web dev",
    "dev:api": "turbo -F api dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "turbo -F api db:push"
  },
  "dependencies": {
    "@Prezzy/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Prezzy/config": "workspace:*",
    "@biomejs/biome": "^2.5.8",
    "turbo": "^2.10.9",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.25.0"
}
